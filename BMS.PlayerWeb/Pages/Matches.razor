@page "/matches"
@inject PlayerApiService PlayerApiService
@inject AccountApiService AccountApiService
@inject AuthState AuthState
@inject NavigationManager NavigationManager

<h1><Icon Name="users" Size="22" /> Ghép trận theo ELO</h1>

@if (!AuthState.IsAuthenticated)
{
    <p class="page-empty">Vui lòng <a href="login">đăng nhập</a> để ghép trận.</p>
}
else if (_loading)
{
    <p>Đang tải...</p>
}
else if (_selectedPlayerId <= 0)
{
    <p class="page-empty">
        Tài khoản của bạn chưa có hồ sơ người chơi (ELO) liên kết - vui lòng liên hệ quản trị viên.
    </p>
}
else
{
    <div class="form-field name-field">
        <label>Bạn là</label>
        <div class="input" style="display:flex;align-items:center;justify-content:space-between;">
            <span>@_myProfile?.DisplayName (ELO @_myProfile?.EloRating)</span>
        </div>
    </div>

    <div class="section">
        <h2><Icon Name="target" Size="18" /> Đối thủ gợi ý (ELO gần nhất)</h2>
        <div class="table-grid">
            @foreach (var suggestion in _suggestions)
            {
                <div class="table-card">
                    <div class="table-card-header">
                        <span class="table-name">@suggestion.DisplayName</span>
                        <span class="badge">ELO @suggestion.EloRating</span>
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="() => SendRequest(suggestion.Id)">
                        Gửi lời mời
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="section">
        <h2><Icon Name="chat" Size="18" /> Lời mời gần đây</h2>
        @if (_requests.Count == 0)
        {
            <p class="page-empty">Chưa có lời mời nào.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Người gửi</th>
                        <th>Đối thủ</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in _requests)
                    {
                        <tr>
                            <td>@request.RequesterName</td>
                            <td>@(request.TargetName ?? "Bất kỳ")</td>
                            <td>@StatusLabel(request.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_message))
{
    <p class="toast-msg" @key="_message" role="status">@_message</p>
}

@code {
    private PlayerProfileDto? _myProfile;
    private List<PlayerProfileDto> _suggestions = new();
    private List<MatchRequestDto> _requests = new();
    private int _selectedPlayerId;
    private bool _loading = true;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            _loading = false;
            return;
        }

        // Luôn dùng hồ sơ (PlayerProfile) của chính tài khoản đang đăng nhập, không cho
        // chọn thủ công nữa - trước đây có thể chọn nhầm người khác trong danh sách dài.
        var (success, profile, _) = await AccountApiService.GetProfileAsync();
        if (success && profile?.PlayerProfileId is int myId)
        {
            _selectedPlayerId = myId;
            _myProfile = await PlayerApiService.GetPlayerAsync(myId);
        }

        _requests = await PlayerApiService.GetMatchRequestsAsync();
        await LoadSuggestionsAsync();
        _loading = false;
    }

    private async Task LoadSuggestionsAsync()
    {
        if (_selectedPlayerId <= 0) return;
        _suggestions = await PlayerApiService.GetSuggestionsAsync(_selectedPlayerId);
    }

    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Đang chờ",
        "Accepted" => "Đã chấp nhận",
        "Rejected" => "Đã từ chối",
        _ => status
    };

    private async Task SendRequest(int targetPlayerId)
    {
        if (!AuthState.IsAuthenticated)
        {
            _message = "Vui lòng đăng nhập để xin ghép trận.";
            NavigationManager.NavigateTo("/login");
            return;
        }

        var (success, error) = await PlayerApiService.SendMatchRequestAsync(_selectedPlayerId, targetPlayerId);
        _message = success ? "Đã gửi lời mời ghép trận." : error;
        _requests = await PlayerApiService.GetMatchRequestsAsync();
    }
}
