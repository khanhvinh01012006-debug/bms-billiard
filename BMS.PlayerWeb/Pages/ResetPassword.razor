@page "/reset-password"
@inject AccountApiService AccountApiService
@inject NavigationManager NavigationManager

<div class="login-page">
    <h1 class="login-title">Đặt lại mật khẩu</h1>
    <p class="login-subtitle">Nhập email, mã xác nhận và mật khẩu mới</p>

    <div class="login-form-card">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <div class="form-field">
                <label for="email">Email</label>
                <input id="email" class="input" @bind="_model.Email" placeholder="ban@example.com" />
            </div>
            <div class="form-field">
                <label for="token">Mã đặt lại mật khẩu</label>
                <input id="token" class="input" @bind="_model.Token" placeholder="Dán mã đã nhận" />
            </div>
            <div class="form-field">
                <label for="newPassword">Mật khẩu mới</label>
                <input id="newPassword" type="password" class="input" @bind="_model.NewPassword" placeholder="Tối thiểu 6 ký tự" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="error-text">@_error</p>
            }

            <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
                @(_busy ? "Đang xử lý..." : "Đặt lại mật khẩu")
            </button>
        </EditForm>

        <p class="auth-switch"><a href="login">Quay lại đăng nhập</a></p>
    </div>
</div>

@code {
    private FormModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task HandleSubmit()
    {
        _busy = true;
        _error = null;

        try
        {
            var (success, error) = await AccountApiService.ResetPasswordAsync(_model.Email, _model.Token, _model.NewPassword);
            if (success)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                _error = error ?? "Đặt lại mật khẩu thất bại.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Không thể kết nối tới máy chủ: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class FormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
    }
}
