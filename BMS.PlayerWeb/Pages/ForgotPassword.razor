@page "/forgot-password"
@inject AccountApiService AccountApiService

<div class="login-page">
    <h1 class="login-title">Quên mật khẩu</h1>
    <p class="login-subtitle">Nhập email để nhận mã đặt lại mật khẩu</p>

    <div class="login-form-card">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <div class="form-field">
                <label for="email">Email</label>
                <input id="email" class="input" @bind="_model.Email" placeholder="ban@example.com" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="error-text">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="hint-text">@_message</p>
            }

            @if (!string.IsNullOrEmpty(_debugToken))
            {
                <p class="hint-text">
                    (Chế độ Dev) Mã đặt lại mật khẩu: <strong>@_debugToken</strong><br />
                    <a href="reset-password">Nhập mã này ở trang Đặt lại mật khẩu</a>
                </p>
            }

            <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
                @(_busy ? "Đang gửi..." : "Gửi yêu cầu")
            </button>
        </EditForm>

        <p class="auth-switch"><a href="login">Quay lại đăng nhập</a></p>
    </div>
</div>

@code {
    private FormModel _model = new();
    private string? _error;
    private string? _message;
    private string? _debugToken;
    private bool _busy;

    private async Task HandleSubmit()
    {
        _busy = true;
        _error = null;
        _message = null;
        _debugToken = null;

        try
        {
            var (success, result, error) = await AccountApiService.ForgotPasswordAsync(_model.Email);
            if (success && result is not null)
            {
                _message = result.Message;
                _debugToken = result.DebugToken;
            }
            else
            {
                _error = error ?? "Yêu cầu thất bại.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Không thể kết nối tới máy chủ: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class FormModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
