<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMS.PlayerApp.ForgotPasswordPage"
             Title="Quên mật khẩu">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Quên mật khẩu" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource FeltDark}" />
            <Label Text="Nhập email để nhận mã đặt lại mật khẩu." FontSize="13" />

            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />

            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />
            <Label x:Name="InfoLabel" TextColor="{StaticResource FeltLight}" IsVisible="False" />

            <Button Text="Gửi yêu cầu" Clicked="OnSendClicked" />
            <Button Text="Đã có mã? Đặt lại mật khẩu" BackgroundColor="Transparent" TextColor="{StaticResource FeltDark}" Clicked="OnGoToResetClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
