<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMS.PlayerApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Bảng màu theo hệ thiết kế BilliardHub (D:ms-anh) - cùng giá trị với tokens.css của
                 BMS.PlayerWeb: nền sáng, màu chính Royal Blue, xanh nỉ cho bàn trống, vàng cho đặt trước. -->
            <Color x:Key="Surface">#F8FAFC</Color>
            <Color x:Key="SurfaceLowest">#FFFFFF</Color>
            <Color x:Key="SurfaceLow">#FFFFFF</Color>
            <Color x:Key="SurfaceMid">#F1F5F9</Color>
            <Color x:Key="SurfaceHigh">#E2E8F0</Color>
            <Color x:Key="SurfaceBright">#CBD5E1</Color>
            <Color x:Key="OnSurface">#0F172A</Color>
            <Color x:Key="OnSurfaceVariant">#475569</Color>
            <Color x:Key="Outline">#5A6A80</Color>
            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="PrimaryStrong">#1D4ED8</Color>
            <Color x:Key="OnPrimary">#FFFFFF</Color>
            <Color x:Key="PrimarySoft">#EFF6FF</Color>
            <Color x:Key="Secondary">#B45309</Color>
            <Color x:Key="OnSecondary">#FFFFFF</Color>
            <Color x:Key="SecondarySoft">#FFFBEB</Color>
            <Color x:Key="ErrorColor">#B91C1C</Color>
            <Color x:Key="ErrorSoft">#FEF2F2</Color>

            <!-- Khóa màu cũ giữ nguyên TÊN để các trang hiện có không phải sửa, chỉ đổi giá trị
                 (trạng thái bàn: trống = xanh nỉ, đang chơi = xanh dương, đã đặt = vàng, bảo trì = xám). -->
            <Color x:Key="Felt">#047857</Color>
            <Color x:Key="FeltLight">#10B981</Color>
            <Color x:Key="FeltDark">#0F172A</Color>
            <Color x:Key="Cream">#F8FAFC</Color>
            <Color x:Key="Ink">#0F172A</Color>
            <Color x:Key="Available">#047857</Color>
            <Color x:Key="Occupied">#2563EB</Color>
            <Color x:Key="Reserved">#B45309</Color>
            <Color x:Key="Maintenance">#475569</Color>

            <!-- Font: Inter (đã đóng gói sẵn trong app) cho chữ, Material Icons cho icon. Thiết kế mới
                 dùng Be Vietnam Pro / Plus Jakarta Sans - cần thêm file .ttf vào Resources/Fonts. -->
            <x:String x:Key="IconFont">MaterialIcons</x:String>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMid}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Outline}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMid}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="TitleColor" Value="{StaticResource Outline}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <!-- Nút mặc định = nút chính xanh dương, chữ trắng, bo 8px. -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                                    <Setter Property="TextColor" Value="{StaticResource Outline}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Nút phụ: nền xám nhạt, chữ đậm. -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <!-- Nút vàng (hành động phụ cho bàn đặt trước). -->
            <Style x:Key="GoldButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                <Setter Property="TextColor" Value="{StaticResource OnSecondary}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <!-- Nút dạng liên kết (Quên mật khẩu, Đăng ký...). -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <!-- Thẻ: nền trắng, viền mảnh #E2E8F0, bo 16px (thiết kế "Card Surfaces"). -->
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
                <Setter Property="BorderColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
                <Setter Property="Stroke" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="Inset" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMid}" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="StrokeShape" Value="RoundRectangle 999" />
            </Style>

            <!-- Kiểu chữ: tiêu đề màn hình 26px, tiêu đề thẻ 20px, nhãn in hoa 11px. -->
            <Style x:Key="ScreenTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
            </Style>

            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="0.7" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
            </Style>

            <Style x:Key="ErrorText" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
