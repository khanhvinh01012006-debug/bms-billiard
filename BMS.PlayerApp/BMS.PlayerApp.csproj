<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BMS.PlayerApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>BMS Player</ApplicationTitle>
    <ApplicationId>com.bms.playerapp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Maui.Controls must be referenced explicitly - since .NET 8, UseMaui=true
         alone does NOT automatically pull in Microsoft.Maui.Controls as a package. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <!-- Missing this causes "'ILoggingBuilder' does not contain a definition for 'AddDebug'". -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon and splash - biểu tượng bi 8 xanh trên nền sáng (thiết kế BilliardHub). -->
    <MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appicon.svg" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\Images\appicon.svg" Color="#F8FAFC" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*.svg" Exclude="Resources\Images\appicon.svg" />

    <!-- Đợt 2: Inter (font chữ của Stitch tinh gọn) + Material Icons Outlined (icon). -->
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BMS.Shared\BMS.Shared.csproj" />
  </ItemGroup>

</Project>
