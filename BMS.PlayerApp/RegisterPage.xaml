<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMS.PlayerApp.RegisterPage"
             Title="Đăng ký">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Đăng ký tài khoản" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource FeltDark}" />

            <Entry x:Name="FullNameEntry" Placeholder="Họ và tên" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="PhoneEntry" Placeholder="Số điện thoại (tùy chọn)" Keyboard="Telephone" />

            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="PasswordEntry" Grid.Column="0" Placeholder="Mật khẩu (tối thiểu 6 ký tự)" IsPassword="True" />
                <Button x:Name="TogglePasswordButton" Grid.Column="1" Text="Hiện" Clicked="OnTogglePasswordClicked" />
            </Grid>

            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />

            <Button Text="Đăng ký" Clicked="OnRegisterClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
