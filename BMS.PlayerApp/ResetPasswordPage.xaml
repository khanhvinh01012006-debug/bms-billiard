<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMS.PlayerApp.ResetPasswordPage"
             Title="Đặt lại mật khẩu">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Đặt lại mật khẩu" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource FeltDark}" />

            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="TokenEntry" Placeholder="Mã đặt lại mật khẩu" />

            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="NewPasswordEntry" Grid.Column="0" Placeholder="Mật khẩu mới (tối thiểu 6 ký tự)" IsPassword="True" />
                <Button x:Name="TogglePasswordButton" Grid.Column="1" Text="Hiện" Clicked="OnTogglePasswordClicked" />
            </Grid>

            <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />

            <Button Text="Đặt lại mật khẩu" Clicked="OnResetClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
