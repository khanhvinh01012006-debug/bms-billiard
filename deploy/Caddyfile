# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho 3 tên miền dưới đây,
# và tự chuyển http -> https. Tên miền lấy từ file .env (qua docker-compose.yml).

# Player Web: Blazor WebAssembly (file tĩnh)
{$PLAYER_DOMAIN} {
	root * /srv/player
	# "no-cache" = trình duyệt luôn hỏi lại máy chủ trước khi dùng bản đã lưu. Áp dụng cho mọi
	# file, kể cả service-worker.js / service-worker-assets.js / manifest (PWA), để triển khai
	# xong là người dùng nhận bản mới (service worker tự hiện thông báo "Đã có phiên bản mới").
	header Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	# Đường dẫn SPA (/tables, /wallet, ...) trả về index.html
	try_files {path} /index.html
	encode zstd gzip
	file_server
}

# Admin/Staff Web: Blazor Server (WebSocket /_blazor được Caddy chuyển tiếp tự động)
{$ADMIN_DOMAIN} {
	reverse_proxy admin:8080
}

# API + SignalR
{$API_DOMAIN} {
	# SignalR hub: WebSocket (Upgrade) và long polling. flush_interval -1 để không đệm phản hồi.
	handle /hubs/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy api:8080
	}
}
