# Sao chép thành .env rồi sửa:  cp .env.example .env && nano .env

# Tên miền (DNS đã trỏ về IP VPS)
PLAYER_DOMAIN=bmsbilliard.com
ADMIN_DOMAIN=admin.bmsbilliard.com
API_DOMAIN=api.bmsbilliard.com

# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:  openssl rand -base64 48
JWT_KEY=DOI_THANH_CHUOI_NGAU_NHIEN_IT_NHAT_32_KY_TU

# Tài khoản admin
ADMIN_EMAIL=admin@bms.local
ADMIN_PASSWORD=DoiMatKhauNay@2026
# true = mỗi lần API khởi động sẽ đặt lại mật khẩu của ADMIN_EMAIL theo ADMIN_PASSWORD
# (cần vì database demo đang có sẵn admin với mật khẩu Admin@123).
ADMIN_RESET_PASSWORD=true
