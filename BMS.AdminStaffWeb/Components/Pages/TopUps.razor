@page "/topups"
@rendermode InteractiveServer
@inject WalletApiService WalletApiService
@inject AuthState AuthState
@inject IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<h1><Icon Name="wallet" Size="22" /> Nạp tiền</h1>

@if (!AuthState.IsAdmin)
{
    <p class="page-empty">Bạn không có quyền truy cập trang này. Vui lòng đăng nhập bằng tài khoản Admin.</p>
}
else
{
    <div class="section">
        <h2>Hàng đợi duyệt nạp tiền</h2>
        @if (_pending.Count == 0)
        {
            <p class="page-empty">Không có yêu cầu nạp tiền nào đang chờ duyệt.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Phương thức</th>
                        <th>Số tiền</th>
                        <th>Ghi chú</th>
                        <th>Chứng từ</th>
                        <th>Thời gian</th>
                        <th>Ghi chú xử lý</th>
                        <th>Xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _pending)
                    {
                        <tr>
                            <td>@t.AccountName</td>
                            <td>@(t.Method == "Cash" ? "Tiền mặt" : "Chuyển khoản")</td>
                            <td>@t.Amount.ToString("N0") đ</td>
                            <td>@(t.Note ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.ProofImageUrl))
                                {
                                    <a href="@t.ProofImageUrl" target="_blank">Xem ảnh</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@t.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</td>
                            <td>
                                <input class="input" placeholder="Ghi chú xử lý (tùy chọn)" @bind="_notes[t.Id]" />
                            </td>
                            <td class="row-actions">
                                <button class="btn btn-primary btn-sm" @onclick="() => Approve(t.Id)">Duyệt</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => Reject(t.Id)">Từ chối</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="hint-text">@_message</p>
        }
    </div>

    <div class="section">
        <h2>Báo cáo nạp tiền</h2>
        <div class="form-actions filter-bar">
            <select class="input" @bind="_filterStatus" @bind:after="LoadReportAsync">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Pending">Chờ duyệt</option>
                <option value="Approved">Đã duyệt</option>
                <option value="Rejected">Từ chối</option>
            </select>
            <select class="input" @bind="_filterMethod" @bind:after="LoadReportAsync">
                <option value="">-- Tất cả phương thức --</option>
                <option value="Cash">Tiền mặt</option>
                <option value="BankTransfer">Chuyển khoản</option>
            </select>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Phương thức</th>
                    <th>Số tiền</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                    <th>Người xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _report)
                {
                    <tr>
                        <td>@t.AccountName</td>
                        <td>@MethodLabel(t.Method)</td>
                        <td>@t.Amount.ToString("N0") đ</td>
                        <td>@StatusLabel(t.Status)</td>
                        <td>@t.CreatedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</td>
                        <td>@(t.ProcessedByName ?? "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2"><strong>Tổng nạp tiền đã duyệt</strong></td>
                    <td colspan="4"><strong>@TotalApprovedTopUp.ToString("N0") đ</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private List<TransactionDto> _pending = new();
    private List<TransactionDto> _report = new();
    private Dictionary<int, string> _notes = new();
    private string _filterStatus = "";
    private string _filterMethod = "";
    private string? _message;
    private HubConnection? _hubConnection;

    private decimal TotalApprovedTopUp => _report.Where(t => t.Status == "Approved").Sum(t => t.Amount);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAdmin)
        {
            return;
        }

        await LoadAllAsync();

        var apiBaseUrl = Configuration["Api:BaseUrl"] ?? "https://localhost:5001";
        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiBaseUrl}/hubs/bms")
            .WithAutomaticReconnect(new ForeverRetryPolicy())
            .Build();

        // Mất kết nối rồi tự nối lại: tải lại dữ liệu vì các sự kiện phát ra lúc mất mạng đã bị lỡ.
        _hubConnection.Reconnected += async _ =>
        {
            await LoadAllAsync();
            await InvokeAsync(StateHasChanged);
        };

        _hubConnection.On<object>("TransactionCreated", async _ =>
        {
            await LoadAllAsync();
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch
        {
            // Falls back to manual refresh if the hub isn't reachable yet.
        }
    }

    private async Task LoadAllAsync()
    {
        await LoadPendingAsync();
        await LoadReportAsync();
    }

    private async Task LoadPendingAsync()
    {
        _pending = await WalletApiService.GetPendingTransactionsAsync();
        foreach (var t in _pending)
        {
            if (!_notes.ContainsKey(t.Id))
            {
                _notes[t.Id] = "";
            }
        }
    }

    private async Task LoadReportAsync()
    {
        _report = await WalletApiService.GetAllTransactionsAsync(
            string.IsNullOrEmpty(_filterStatus) ? null : _filterStatus,
            string.IsNullOrEmpty(_filterMethod) ? null : _filterMethod,
            "TopUp");
    }

    private async Task Process(int id, bool approve)
    {
        var note = _notes.TryGetValue(id, out var n) ? n : null;
        var (success, error) = await WalletApiService.ProcessTransactionAsync(id, approve, note);
        _message = success
            ? (approve ? "Đã duyệt yêu cầu nạp tiền." : "Đã từ chối yêu cầu nạp tiền.")
            : error;
        await LoadAllAsync();
    }

    private Task Approve(int id) => Process(id, true);
    private Task Reject(int id) => Process(id, false);

    private static string MethodLabel(string method) => method switch
    {
        "Cash" => "Tiền mặt",
        "BankTransfer" => "Chuyển khoản",
        _ => method
    };

    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        _ => status
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
