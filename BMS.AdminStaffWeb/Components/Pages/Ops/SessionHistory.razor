@page "/staff/history"
@rendermode InteractiveServer
@inject TableApiService TableApiService
@inject AuthState AuthState

<h1><Icon Name="clock" Size="22" /> Lịch sử phiên chơi</h1>

@if (!AuthState.IsStaffOrAdmin)
{
    <p class="hint-text">Trang này chỉ dành cho Nhân viên và Admin. Vui lòng đăng nhập.</p>
}
else
{
    @if (_sessions.Count == 0)
    {
        <p class="page-empty">Chưa có phiên chơi nào đã kết thúc.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Bàn</th>
                    <th>Khách</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Thời gian</th>
                    <th>Tiền order</th>
                    <th>Phụ thu</th>
                    <th>Tổng cộng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td>@s.TableName</td>
                        <td>@s.CustomerName</td>
                        <td>@s.StartedAtUtc.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</td>
                        <td>@(s.EndedAtUtc?.ToLocalTime().ToString("HH:mm dd/MM/yyyy") ?? "—")</td>
                        <td>@Duration(s)</td>
                        <td>@s.OrdersAmount.ToString("N0") đ</td>
                        <td>@s.SurchargeAmount.ToString("N0") đ</td>
                        <td>@(s.TotalAmount?.ToString("N0") ?? "0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<SessionHistoryDto> _sessions = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsStaffOrAdmin)
        {
            return;
        }

        _sessions = await TableApiService.GetSessionHistoryAsync();
    }

    private static string Duration(SessionHistoryDto s)
    {
        if (s.EndedAtUtc is null) return "—";
        var span = s.EndedAtUtc.Value - s.StartedAtUtc;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.ToString(@"hh\:mm\:ss");
    }
}
